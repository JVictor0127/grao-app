generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NOSSAS TABELAS ---

model Usuario {
  id            Int               @id @default(autoincrement())
  nome          String
  apelido       String?
  email         String            @unique
  senha         String
  criadoEm      DateTime          @default(now())
  movimentacoes RegMovimentacao[]
  categorias    Categoria[]
  beneficiarios Beneficiario[]    // <-- Nova relação
}

model Categoria {
  id            Int               @id @default(autoincrement())
  nome          String
  usuario_id    Int
  usuario       Usuario           @relation(fields: [usuario_id], references: [id])
  movimentacoes RegMovimentacao[]
}

// <-- NOVA TABELA -->
model Beneficiario {
  id            Int               @id @default(autoincrement())
  nome          String
  usuario_id    Int
  usuario       Usuario           @relation(fields: [usuario_id], references: [id])
  movimentacoes RegMovimentacao[]
}

model RegMovimentacao {
  id              Int           @id @default(autoincrement())
  descricao       String
  valor           Decimal
  tipo            String
  usuario_id      Int
  id_categoria    Int
  usuario         Usuario       @relation(fields: [usuario_id], references: [id])
  categoria       Categoria     @relation(fields: [id_categoria], references: [id])
  criadoEm        DateTime      @default(now())

  // <-- NOVOS CAMPOS -->
  beneficiario_id Int?
  beneficiario    Beneficiario? @relation(fields: [beneficiario_id], references: [id])
  formaPagamento  String?
  status          String?       @default("Pago") // Ex: Pendente, Pago, Atrasado
  dataVencimento  DateTime?
  dataTitulo      DateTime?     @default(now())
}